# Copy to ~/.running-coach/.env (or export these in your shell / Claude config "env" block)

# https://www.strava.com/settings/api  (Authorization Callback Domain: localhost)
STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=

# https://developer-dashboard.whoop.com  (Redirect URL: http://localhost:8723/callback)
WHOOP_CLIENT_ID=
WHOOP_CLIENT_SECRET=

# Optional
# RUNNING_COACH_HOME=~/.running-coach
# RUNNING_COACH_OAUTH_PORT=8723
